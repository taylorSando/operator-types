{
  "name": "@operator/types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for the operator-owned browser-bridge capture surface: ControlPlaneCapture, OperatorContextPacket, capture envelope, probe pub/sub, and the known event-type catalog.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./src": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taylorSando/operator-types.git"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
